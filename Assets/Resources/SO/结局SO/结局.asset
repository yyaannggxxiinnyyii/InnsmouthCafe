  endingReturn:
    cutsceneSlides:
    - image: {fileID: 21300000, guid: 2678bf0c656ea9b4bab13cf1b2c1c0cf, type: 3}
      text: "\u5C3D\u7BA1\u6709\u4E9B\u9648\u65E7\uFF0C\u5370\u65AF\u8305\u65AF\u4ECD\u7136\u5FE0\u5B9E\u7684\u5438\u5F15\u7740\u597D\u5947\u7684\u6E38\u5BA2\u3002"
    - image: {fileID: 21300000, guid: 32418160ad3bda5419ae8bae2fdf1432, type: 3}
      text: "\u800C\u6211\uFF0C\u5728\u65E5\u76CA\u589E\u591A\u7684\u670B\u53CB\u548C\u987E\u5BA2\u4E4B\u95F4\uFF0C\u9010\u6E10\u63A5\u53D7\u4E86\u5145\u5B9E\u800C\u65E0\u5FE7\u65E0\u8651\u7684\u751F\u6D3B\u3002"
    bgm: {fileID: 8300000, guid: b0ed959618704ec40b817b82f8a108e1, type: 3}
    endingImage: {fileID: 21300000, guid: 97ce3c19f1559fc4bb01beededc50db7, type: 3}
    endingTitle: "B\u7ED3\u5C40"
    endingDescription: "\u5C3D\u7BA1\u6709\u4E9B\u9648\u65E7\uFF0C\u5370\u65AF\u8305\u65AF\u4ECD\u7136\u5FE0\u5B9E\u7684\u5438\u5F15\u7740\u597D\u5947\u7684\u6E38\u5BA2\uFF1B\u800C\u6211\uFF0C\u5728\u65E5\u76CA\u589E\u591A\u7684\u670B\u53CB\u548C\u987E\u5BA2\u4E4B\u95F4\uFF0C\u9010\u6E10\u63A5\u53D7\u4E86\u5145\u5B9E\u800C\u65E0\u5FE7\u65E0\u8651\u7684\u751F\u6D3B\u3002"
  endingGood:
    cutsceneSlides:
    - image: {fileID: 21300000, guid: 105034ab532f6934a9c4de8b00143e46, type: 3}
      text: "\u6211\u53D1\u75AF\u822C\u5730\u9003\u51FA\u4E86\u5370\u65AF\u8305\u65AF\u3002"
    - image: {fileID: 21300000, guid: 0ec040cd76948d64d9bed5c1ed591b5d, type: 3}
      text: "\u4E4B\u540E\uFF0C\u6211\u60CA\u6050\u4E07\u5206\u5730\u5411\u653F\u5E9C\u7533\u8BF7\u5C55\u5F00\u8C03\u67E5\u4E0E\u4ECB\u5165\u884C\u52A8\uFF0C\u5E76\u6700\u7EC8\u5BFC\u81F4\u4E86\u540E\u6765\u4E00\u7CFB\u5217\u89C1\u8BF8\u62A5\u7AEF\u7684\u4E8B\u4EF6\u3002 "
    bgm: {fileID: 8300000, guid: 8db5f8751cdbc284bac4420157a152c1, type: 3}
    endingImage: {fileID: 21300000, guid: 38459676ace6b854eafd19b7d6b381da, type: 3}
    endingTitle: "A\u7ED3\u5C40"
    endingDescription: "\u7B80\u76F4\u5C31\u50CF\u68A6\u4E00\u6837\uFF0C\u4E0D\u8FC7\u5DF2\u7ECF\u7ED3\u675F\u4E86\uFF0C\u4E0D\u662F\u5417\uFF1F"
