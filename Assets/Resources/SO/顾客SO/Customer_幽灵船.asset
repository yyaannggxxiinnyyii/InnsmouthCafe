  specialProfile: {fileID: 11400000, guid: 56b797b943333b6438a7303221ff6488, type: 2}
  galleryCharacterDescription: "\u4E8E\u53E4\u5F80\u4ECA\u6765\u5145\u6EE1\u7740\u91CE\u5FC3\u548C\u6B32\u671B\u7684\u6D77\u6D0B\u8D22\u5B9D\u4E89\u593A\u6218\u4E2D\u8BDE\u751F\u7684\u9B3C\u9B42\uFF0C\u884C\u4E8B\u5F20\u72C2\uFF0C\u8BDD\u75E8\u4E14\u534E\u4E3D\uFF0C\u603B\u662F\u5927\u58F0\u56B7\u56B7\u3002"
  galleryEffectDescription: "\u8FFD\u6C42\u534E\u4E3D\u7684\u5E7D\u7075\u8239\u957F\u4F1A\u5E26\u6765\u4E00\u4EFD\u8D85\u7EA7\u8C6A\u534E\u7684\u8BA2\u5355\u3002\n\u6548\u679C\uFF1A\u8BA2\u5355\u9700\u6C42\u5927\u5E45\u589E\u52A0"
  enterDialogueTexts:
  - "\u4E0D\u552E\u9152\u7C7B\u662F\u4EC0\u4E48\u610F\u601D\uFF1F\u7B97\u4E86\uFF0C\u968F\u4FBF\u7ED9\u6211\u6765\u70B9\u5565\u90FD\u52A0\u7684\u8D85\u8C6A\u534E\u7279\u8C03\u3002"
  - "\u53EF\u4EE5\u7528\u91D1\u5E01\u4ED8\u8D26\u5417\uFF1F\u5C3C\u83AB\uFF0C\u4F60\u7684\u8001\u670B\u53CB\u7A77\u7684\u53EA\u5269\u8FD9\u4E2A\u5566\uFF0C\u54C8\u54C8\u54C8\uFF01"
  - "\u5341\u4E94\u4E2A\u4EBA\u4E89\u593A\u6B7B\u4EBA\u7BB1\uFF0C\u5176\u4F59\u7684\u90FD\u88AB\u9152\u548C\u9B54\u9B3C\u65AD\u9001\u4E86\u547D\uFF0C\u4E03\u5341\u4E94\u4E2A\u4EBA\u968F\u8239\u51FA\u6D77\uFF0C\u53EA\u5269\u4E00\u4E2A\u6D3B\u7740\u56DE\u6765
    \u3002"
  hasCollectible: 1
  collectible: {fileID: 11400000, guid: 5756b9a9675941d479eb04a790f8d20f, type: 2}
  rewardLiquidsOnPerfect: []
  rewardToppingsOnPerfect: []
  satisfiedFeedbackTexts:
  - "\u8FD9\u79CD\u611F\u89C9\u4F7F\u6211\u7CBE\u795E\u767E\u500D\uFF0C\u5C0F\u7684\u4EEC\uFF0C\u626C\u5E06\uFF0C\u542F\u822A\uFF01\u55EF\uFF1F\u4F60\u4E0D\u6253\u7B97\u52A0\u5165\u6211\u5417\uFF1F"
  neutralFeedbackTexts:
  - "\u5478\uFF0C\u8FD9\u73A9\u610F\u53EF\u80FD\u4E0D\u592A\u9002\u5408\u6211\u3002\u4E0D\u8FC7\u8FD9\u5473\u9053\u786E\u5B9E\u5F88\u65B0\u5947\u3002"
  dissatisfiedFeedbackTexts:
  - "\u8FD9\u9178\u82E6\u5473\u50CF\u8239\u8231\u91CC\u653E\u4E86\u5341\u5E74\u7684\u70C2\u6C34\u679C\uFF01\u4F60\u5C31\u8FD9\u4E48\u6577\u884D\u672C\u5927\u7237\u5417\uFF1F"
  SpecialFeedbackTexts:
  - "\u53EF\u4EE5\u7528\u91D1\u5E01\u4ED8\u8D26\u5417\uFF1F\u5C3C\u83AB\uFF0C\u4F60\u7684\u8001\u8239\u957F\u7A77\u7684\u53EA\u5269\u8FD9\u4E2A\u5566\uFF0C\u54C8\u54C8\u54C8\uFF01"
  - "\u5341\u4E94\u4E2A\u4EBA\u4E89\u593A\u6B7B\u4EBA\u7BB1\uFF0C\u5176\u4F59\u7684\u90FD\u88AB\u9152\u548C\u9B54\u9B3C\u65AD\u9001\u4E86\u547D\uFF0C\u4E03\u5341\u4E94\u4E2A\u4EBA\u968F\u8239\u51FA\u6D77\uFF0C\u53EA\u5269\u4E00\u4E2A\u6D3B\u7740\u56DE\u6765
    \u3002"
