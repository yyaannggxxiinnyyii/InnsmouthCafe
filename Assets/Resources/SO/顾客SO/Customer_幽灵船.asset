  customerId: C02
  customerName: "\u5E7D\u7075\u8239"
  normalSprite: {fileID: 21300000, guid: a7c71f8a50dbb684ab07fd2ecac4e486, type: 3}
  impatientSprite: {fileID: 21300000, guid: 6fefe662b3cdfcc4bb66a6ac64e2cbd5, type: 3}
  angrySprite: {fileID: 21300000, guid: 7bc0f780f4252914589c2ba411c7a166, type: 3}
