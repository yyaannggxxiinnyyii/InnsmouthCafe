  specialProfile: {fileID: 11400000, guid: ca15805333ef485408226759420078e6, type: 2}
  galleryCharacterDescription: "\u6709\u7740\u4F17\u591A\u4EB2\u670B\u597D\u53CB\u7684\u4F18\u96C5\u592B\u4EBA\uFF0C\u517B\u80B2\u7740\u8BB8\u591A\u5B69\u5B50\uFF0C\u6177\u6168\u597D\u5BA2\uFF0C\u662F\u793E\u4EA4\u7684\u8FBE\u4EBA\u3002\u8FFD\u6C42\u7740\u5DF4\u6D1B\u514B\u7684\u5BA1\u7F8E\uFF0C\u5BF9\u751F\u6D3B\u54C1\u8D28\u5F88\u6709\u8FFD\u6C42\u3002\u4F3C\u4E4E\u548C\u8001\u677F\u662F\u65E7\u76F8\u8BC6\u3002"
  galleryEffectDescription: "\u592B\u4EBA\u7684\u8FFD\u968F\u8005\u603B\u662F\u5F88\u4E50\u4E8E\u5149\u987E\u5979\u6765\u8FC7\u7684\u5E97\u94FA\u3002\r\n\u6548\u679C\uFF1A\u5C0F\u4E11\u9C7C\u987E\u5BA2\u5728\u4ECA\u5929\u4F1A\u5927\u91CF\u51FA\u73B0\u3002"
  enterDialogueTexts:
  - " \u4F60\u7684\u8001\u677F\u5DF2\u7ECF\u901A\u77E5\u8FC7\u6211\u7684\u62DC\u8BBF\u4E86\u5417\uFF1F"
  hasCollectible: 1
  collectible: {fileID: 11400000, guid: 51dec1bacbfa5ba4f98020feecc6c06d, type: 2}
  rewardLiquidsOnPerfect: []
  rewardToppingsOnPerfect: []
  satisfiedFeedbackTexts:
  - "\u5662\u5475\u5475\uFF0C\u4EB2\u7231\u7684\uFF0C\u6211\u771F\u60F3\u8BA9\u4F60\u4E00\u76F4\u4E3A\u6211\u7684\u6D77\u5E95\u8336\u4F1A\u63D0\u4F9B\u670D\u52A1\u3002"
  neutralFeedbackTexts:
  - "\u55EF\uFF0C\u8FD8\u6709\u8FDB\u6B65\u7684\u7A7A\u95F4\uFF0C\u60F3\u4E0D\u60F3\u548C\u6211\u7684\u53A8\u5B50\u4EA4\u6D41\u4E00\u4E0B\u5FC3\u5F97\uFF1F"
  dissatisfiedFeedbackTexts:
  - "\u5929\u54EA\uFF0C\u4F60\u5E94\u8BE5\u53C2\u52A0\u6211\u529E\u7684\u7F8E\u98DF\u8BB2\u5EA7\uFF0C\u6211\u7684\u9A6C\u8F66\u5C31\u5728\u6F6E\u95F4\u5E26\u7B49\u7740\u3002"
  - "\u5982\u679C\u4F60\u60F3\u505A\u7684\u66F4\u597D\u4E00\u70B9\uFF0C\u6700\u597D\u8D81\u65E9\u8DDF\u5C3C\u83AB\u8BF7\u4E2A\u5047\uFF01"
  SpecialFeedbackTexts: []
