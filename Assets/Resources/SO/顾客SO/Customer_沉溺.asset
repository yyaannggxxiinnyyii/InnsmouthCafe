  rewardLiquidsOnPerfect: []
  rewardToppingsOnPerfect: []
  satisfiedFeedbackTexts:
  - "\u6211\u7684\u7F8E\u4E3D\u7684\u68A6\u5E7B\u6CE1\u5F71\uFF0C\u4E00\u676F\u53EF\u4EE5\u8BA9\u6211\u5FD8\u5374\u8FD9\u5BD2\u51B7\u6C34\u5E95\u7684\u996E\u54C1\uFF0C\u60A8\u7684\u624B\u827A\u771F\u662F\u7F8E\u4E3D\u52A8\u4EBA\u3002"
  neutralFeedbackTexts:
  - "\u77ED\u6682\u7684\u82E6\u5473\uFF0C\u7136\u540E\u662F\u719F\u6089\u7684\u9ED1\u6697\u3002"
  dissatisfiedFeedbackTexts:
  - "\u5C31\u50CF\u6D77\u6C34\u4E00\u6837\u82E6\u6DA9\uFF01\u4EC0\u4E48\u90FD\u6CA1\u80FD\u6539\u53D8\uFF01\u4F60\u8FD9\u4E2A\u6765\u81EA\u6DF1\u6D77\u7684\u6076\u9B54\uFF01\u5C3C\u83AB\uFF0C\u4F60\u4E3A\u4F55\u4E0D\u4EB2\u81EA\u73B0\u8EAB\uFF01"
  SpecialFeedbackTexts:
  - "\u6CA1\u6709\u65F6\u95F4\u4E86\u2026\u2026\u53EF\u4EE5\uFF0C\u63E1\u4F4F\u6211\u7684\u624B\u5417\uFF1F"
