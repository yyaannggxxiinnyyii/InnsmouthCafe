  specialProfile: {fileID: 11400000, guid: ef78fb412ee5da44caab70f8b6d9ab3c, type: 2}
  galleryCharacterDescription: "\u88AB\u6D77\u8349\u6C38\u8FDC\u7559\u5728\u6B64\u5904\u7684\u5F02\u4E61\u4EBA\uFF0C\u5FC3\u60C5\u6025\u8E81\uFF0C\u5145\u6EE1\u6050\u60E7\u3002\u81EA\u4ECE\u90A3\u7231\u4E0A\u4E86\u81EA\u5DF1\u5012\u5F71\u7684\u7F8E\u5C11\u5E74\u6210\u4E3A\u6C34\u8FB9\u7684\u7F8E\u4E3D\u82B1\u6735\u4E4B\u540E\uFF0C\u90A3\u9634\u51B7\u7684\u6C14\u606F\u5C31\u5728\u5F02\u4E61\u4EBA\u4E2D\u95F4\u4F20\u64AD\u3002"
  galleryEffectDescription: "\u6C89\u6EBA\u6027\u60C5\u6025\u8E81\u5E76\u4E14\u603B\u662F\u7126\u8651\u4E0D\u5B89\uFF0C\u5979\u6CA1\u6709\u5F88\u591A\u7B49\u5F85\u7684\u65F6\u95F4\u3002\r\n\u6548\u679C\uFF1A\u7B49\u5F85\u65F6\u95F4\u5927\u5E45\u7F29\u77ED"
  enterDialogueTexts:
  - "\u2026\u2026\u4E00\u5207\u90FD\u67D3\u4E0A\u4E86\u6C34\u7684\u8165\u5473\uFF0C\u545C\u545C\u545C\uFF0C\u6211\u60F3\u5FF5\u4E00\u676F\u5496\u5561\u7684\u6E29\u5EA6\u2026\u2026"
  hasCollectible: 1
  collectible: {fileID: 11400000, guid: fb73fc02b37d30b4398fac0ab12d6810, type: 2}
  rewardLiquidsOnPerfect: []
  rewardToppingsOnPerfect: []
  satisfiedFeedbackTexts:
  - "\u6211\u7684\u7F8E\u4E3D\u7684\u68A6\u5E7B\u6CE1\u5F71\uFF0C\u4E00\u676F\u53EF\u4EE5\u8BA9\u6211\u5FD8\u5374\u8FD9\u5BD2\u51B7\u6C34\u5E95\u7684\u996E\u54C1\uFF0C\u60A8\u7684\u624B\u827A\u771F\u662F\u7F8E\u4E3D\u52A8\u4EBA\u3002"
  neutralFeedbackTexts:
  - "\u77ED\u6682\u7684\u82E6\u5473\uFF0C\u7136\u540E\u662F\u719F\u6089\u7684\u9ED1\u6697\u3002"
  dissatisfiedFeedbackTexts:
  - "\u5C31\u50CF\u6D77\u6C34\u4E00\u6837\u82E6\u6DA9\uFF01\u4EC0\u4E48\u90FD\u6CA1\u80FD\u6539\u53D8\uFF01\u4F60\u8FD9\u4E2A\u6765\u81EA\u6DF1\u6D77\u7684\u6076\u9B54\uFF01\u5C3C\u83AB\uFF0C\u4F60\u4E3A\u4F55\u4E0D\u4EB2\u81EA\u73B0\u8EAB\uFF01"
  SpecialFeedbackTexts:
  - "\u6CA1\u6709\u65F6\u95F4\u4E86\u2026\u2026\u53EF\u4EE5\uFF0C\u63E1\u4F4F\u6211\u7684\u624B\u5417\uFF1F"
