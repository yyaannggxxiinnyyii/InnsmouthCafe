  orderPoolEntries:
  - orderPool: {fileID: 11400000, guid: b32d38cce17b3584287765556e45b11c, type: 2}
    weight: 100
  enterDialogueTexts:
  - "\u201C\u7A7F\u7740\u8FD9\u8EAB\u8863\u670D\u5DE5\u4F5C\u53EF\u662F\u771F\u591F\u7D2F\u7684\uFF0C\u5927\u6982\uFF1F\u5E0C\u671B\u4E00\u676F\u5496\u5561\u80FD\u8BA9\u6211\u4EEC\u7CBE\u795E\u4E00\u70B9\u3002\u6709\u6CA1\u6709\u9002\u5408\u6C99\u4E01\u9C7C\u7684\u54C1\u7C7B\u2026\u2026\u6211\u4EEC\uFF0C\u989D\u6211\u662F\u8BF4\u9002\u5408\u6F5C\u6C34\u5458\u7684\u54C1\u7C7B\u3002\u201D"
  satisfiedFeedbackTexts:
  - "\u201C\u8EAB\u4F53\u4F3C\u4E4E\u53D8\u5F97\u8F7B\u76C8\u4E86\u2026\u2026\u6211\u4EEC\u53EF\u4EE5\u53BB\u66F4\u8FDC\u7684\u9646\u5730\u3002\u201D"
  neutralFeedbackTexts:
  - "\u201C\u8FD9\u4E2A\u5473\u9053\uFF0C\u5E94\u8BE5\u662F\u8FD9\u6837\u7684\u5417\uFF1F\u771F\u7684\u5417\uFF1F\u6211\u4EEC\u5F88\u597D\u3002\u201D"
  dissatisfiedFeedbackTexts:
  - "\u201C\u8FD9\u548C\u5012\u8FDB\u6D77\u91CC\u7684\u5176\u4ED6\u4E1C\u897F\u6CA1\u6709\u4EC0\u4E48\u533A\u522B\uFF01\u800C\u4F60\u5C45\u7136\u8BA9\u6211\u4EEC\u7B49\u4E86\u8FD9\u4E48\u4E45\uFF01\u201D"
  SpecialFeedbackTexts: []
