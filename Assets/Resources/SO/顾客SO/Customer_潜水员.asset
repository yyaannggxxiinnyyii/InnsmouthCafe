  specialProfile: {fileID: 11400000, guid: 3fa361fb9bdaca34dbd9234b2c4f0a0a, type: 2}
  galleryCharacterDescription: "\u8BF4\u8BDD\u5495\u565C\u5495\u565C\u7684\u6C99\u4E01\u9C7C\u7FA4\u548C\u6F5C\u6C34\u5458\u5916\u58F3\u7684\u5171\u751F\u4F53\uFF0C\u6563\u53D1\u7740\u5FAE\u5149\u7684\u9C7C\u7FA4\u627E\u5230\u4E86\u4E00\u526F\u6C89\u91CD\u7684\u8001\u5F0F\u6F5C\u6C34\u670D\uFF0C\u5B83\u4EEC\u6A21\u4EFF\u8D77\u4E86\u66FE\u89C1\u8FC7\u7684\u6F5C\u6C34\u5458\uFF0C\u9A71\u4F7F\u7740\u8FD9\u526F\u65E9\u5DF2\u6210\u4E3A\u7A7A\u58F3\u7684\u76AE\u56CA\u8D70\u5411\u9646\u5730"
  galleryEffectDescription: "\u4F60\u5F88\u5E78\u8FD0\u78B0\u5230\u4E86\u6700\u53CB\u597D\u7684\u4E00\u4F4D\u987E\u5BA2\uFF0C\u4ED6\u4F1A\u9976\u6709\u5174\u8DA3\u5730\u89C2\u5BDF\u4F60\u5236\u4F5C\u5496\u5561\u7684\u8FC7\u7A0B\u3002\n\u6548\u679C\uFF1A\u987E\u5BA2\u8010\u5FC3\u503C\u589E\u52A0"
  enterDialogueTexts:
  - "\u7A7F\u7740\u8FD9\u8EAB\u8863\u670D\u5DE5\u4F5C\u53EF\u662F\u771F\u591F\u7D2F\u7684\uFF0C\u5927\u6982\uFF1F\u5E0C\u671B\u4E00\u676F\u5496\u5561\u80FD\u8BA9\u6211\u4EEC\u7CBE\u795E\u4E00\u70B9\u3002"
  - "\u6709\u6CA1\u6709\u9002\u5408\u6C99\u4E01\u9C7C\u7684\u54C1\u7C7B\u2026\u2026\u6211\u4EEC\uFF0C\u989D\u6211\u662F\u8BF4\u9002\u5408\u6F5C\u6C34\u5458\u7684\u54C1\u7C7B\u3002"
  - "\u5DE6\u811A\u2026\u2026\u53F3\u811A\uFF0C\u4F60\u95EE\u4E86\u5F88\u591A\u95EE\u9898\uFF0C\u662F\u4E0D\u662F\u56E0\u4E3A\u6211\u7684\u7A7F\u7740\u6253\u626E\uFF1F\u563F\u2026\u2026\u4F46\u662F\u771F\u7684\uFF0C\u8C22\u8C22\u4F60\u5F00\u95E8"
  hasCollectible: 1
  collectible: {fileID: 11400000, guid: b9f3487fd2ec3a84185a5f15f3f7a49c, type: 2}
  rewardLiquidsOnPerfect: []
  rewardToppingsOnPerfect: []
  satisfiedFeedbackTexts:
  - "\u8EAB\u4F53\u4F3C\u4E4E\u53D8\u5F97\u8F7B\u76C8\u4E86\u2026\u2026\u6211\u4EEC\u53EF\u4EE5\u53BB\u66F4\u8FDC\u7684\u9646\u5730\u3002"
  neutralFeedbackTexts:
  - "\u8FD9\u4E2A\u5473\u9053\uFF0C\u5E94\u8BE5\u662F\u8FD9\u6837\u7684\u5417\uFF1F\u771F\u7684\u5417\uFF1F\u6211\u4EEC\u5F88\u597D\u3002"
  dissatisfiedFeedbackTexts:
  - "\u8FD9\u548C\u5012\u8FDB\u6D77\u91CC\u7684\u5176\u4ED6\u4E1C\u897F\u6CA1\u6709\u4EC0\u4E48\u533A\u522B\uFF01\u800C\u4F60\u5C45\u7136\u8BA9\u6211\u4EEC\u7B49\u4E86\u8FD9\u4E48\u4E45\uFF01"
  SpecialFeedbackTexts: []
