  specialProfile: {fileID: 11400000, guid: a7d21451f90f52348a4592d840e7f03d, type: 2}
  galleryCharacterDescription: "\u8FD9\u4F4D\u817C\u8146\u80C6\u5C0F\u7684\u533B\u5E08\u6709\u5947\u602A\u7684\u5BF9\u996E\u54C1\u7684\u8FFD\u6C42\uFF0C\u91CD\u89C6\u6BCF\u4E00\u53E3\u996E\u54C1\u7684\u5065\u5EB7\u6307\u6807\uFF0C\u6E29\u67D4\u53EF\u4EB2\u7684\u533B\u5E08\u60F3\u77E5\u9053\u4E3A\u4EC0\u4E48\u5927\u5BB6\u8FD9\u4E48\u5BB9\u6613\u751F\u75C5\uFF0C\u5E76\u53D1\u8A93\u8981\u4EB2\u624B\u6CBB\u597D\u6BCF\u4E00\u4F4D\u75C5\u60A3\u3002"
  galleryEffectDescription: "\u533B\u5E08\u7684\u611F\u5B98\u603B\u662F\u6BD4\u5176\u4ED6\u4EBA\u654F\u9510\u5F88\u591A\uFF0C\u8981\u6C42\u4E5F\u5F88\u9AD8\u3002\r\n\u6548\u679C\uFF1A\u5BF9\u996E\u54C1\u8C03\u914D\u7684\u7CBE\u5EA6\u8981\u6C42\u4E0A\u5347\uFF0C\u5931\u8BEF\u7684\u7406\u667A\u60E9\u7F5A\u7FFB\u500D\u3002"
  enterDialogueTexts:
  - "\u4F60\u597D\u5440\uFF0C\u4F60\u4E5F\u5728\u8FD9\u91CC\u4E3A\u5927\u5BB6\u5DE5\u4F5C\u5417\uFF1F"
  - "\u4E00\u676F\u5496\u5561\uFF0C\u4F60\u4E0D\u4ECB\u610F\u6211\u6309\u7167\u81EA\u5DF1\u7684\u53E3\u5473\u8C03\u6574\u4E00\u4E0B\u5427\uFF1F\u8BB0\u5F97\u628A\u676F\u5B50\u6D17\u5E72\u51C0\u3002"
  hasCollectible: 1
  collectible: {fileID: 11400000, guid: 8a89db1e53d9d0e41903060b9c0aa601, type: 2}
  rewardLiquidsOnPerfect: []
  rewardToppingsOnPerfect: []
  satisfiedFeedbackTexts:
  - "\u4F60\u548C\u6211\u7684\u670B\u53CB\u4EEC\u5E94\u8BE5\u5F88\u5408\u5F97\u6765\uFF0C\u5E0C\u671B\u4E0B\u6B21\u4F1A\u9762\u65F6\u4E5F\u53EF\u4EE5\u559D\u5230\u4F60\u505A\u7684\u5496\u5561\u3002"
  neutralFeedbackTexts:
  - "\u5C1D\u8D77\u6765\u50CF\u662F\u6709\u70B9\u505A\u574F\u4E86\u3002\u9700\u8981\u6211\u5E2E\u5FD9\u8C03\u6574\u4E00\u4E0B\u914D\u65B9\u5417\uFF1F"
  dissatisfiedFeedbackTexts:
  - "\u559D\u4E86\u8FD9\u79CD\u4E1C\u897F\u7EDD\u5BF9\u4F1A\u751F\u75C5\u7684\u5427\uFF01\u6211\u4EEC\u4E0D\u4F1A\u8BA9\u4F60\u8FD9\u6837\u7684\u5BB6\u4F19\u52A0\u5165\uFF01"
  SpecialFeedbackTexts: []
