    weight: 100
  enterDialogueTexts:
  - "\u201C\u4F60\u597D\u5440\uFF0C\u4F60\u4E5F\u5728\u8FD9\u91CC\u4E3A\u5927\u5BB6\u5DE5\u4F5C\u5417\uFF1F\u4E00\u676F\u5496\u5561\uFF0C\u4F60\u4E0D\u4ECB\u610F\u6211\u6309\u7167\u81EA\u5DF1\u7684\u53E3\u5473\u8C03\u6574\u4E00\u4E0B\u5427\uFF1F\u8BB0\u5F97\u628A\u676F\u5B50\u6D17\u5E72\u51C0\u3002\u201D"
  hasCollectible: 1
  collectible: {fileID: 11400000, guid: 8a89db1e53d9d0e41903060b9c0aa601, type: 2}
  satisfiedFeedbackTexts:
  - "\u201C\u4F60\u548C\u6211\u7684\u670B\u53CB\u4EEC\u5E94\u8BE5\u5F88\u5408\u5F97\u6765\uFF0C\u5E0C\u671B\u4E0B\u6B21\u4F1A\u9762\u65F6\u4E5F\u53EF\u4EE5\u559D\u5230\u4F60\u505A\u7684\u5496\u5561\u3002\u201D"
  neutralFeedbackTexts:
  - "\u201C\u5C1D\u8D77\u6765\u50CF\u662F\u6709\u70B9\u505A\u574F\u4E86\u3002\u9700\u8981\u6211\u5E2E\u5FD9\u8C03\u6574\u4E00\u4E0B\u914D\u65B9\u5417\uFF1F\u201D"
  dissatisfiedFeedbackTexts:
  - "\u201C\u559D\u4E86\u8FD9\u79CD\u4E1C\u897F\u7EDD\u5BF9\u4F1A\u751F\u75C5\u7684\u5427\uFF01\u6211\u4EEC\u4E0D\u4F1A\u8BA9\u4F60\u8FD9\u6837\u7684\u5BB6\u4F19\u52A0\u5165\uFF01\u201D"
