  normalSprite: {fileID: 21300000, guid: 68192d6bb93c9114b82da33f59dfd68f, type: 3}
  impatientSprite: {fileID: 21300000, guid: 3bab830a1cb2fcb4a88292deefbd2a35, type: 3}
